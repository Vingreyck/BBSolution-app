<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+: nada vai para a nuvem nem passa para um celular novo na
    transferência. A sessão é cifrada com chave deste aparelho, e as OS em
    cache voltam do servidor no primeiro login.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
